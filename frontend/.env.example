# Local Python API. Leave this unset on Vercel so the app calls /api on the same host.
REACT_APP_BACKEND_URL=http://localhost:8000

# Only for local `supabase functions serve` (the Vercel proxy adds the key itself):
# REACT_APP_BACKEND_URL=http://127.0.0.1:54321/functions/v1
# REACT_APP_SUPABASE_ANON_KEY=

# Vercel server env, not baked into the browser bundle:
# SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
# SUPABASE_ANON_KEY=
